# AFORO API — STAGING template. Copy to the server as shared/.env (mode 600,
# owner = the deploy user), fill every CHANGE_ME, never commit the result.
# Runbook: docs/staging-runbook.md. Gate: php artisan aforo:deploy-check.
#
# Hosts (decide once; see runbook §2):
#   API_HOST  = api-staging.conejocreative.com   (API + Reverb wss on the same host)
#   WEB_HOST  = CHANGE_ME_WEB_HOST                (SPA, e.g. app-staging.<same parent>)
#   PARENT    = the parent domain shared by API_HOST and WEB_HOST
# Every value below that depends on them is marked.

APP_NAME=AFORO
APP_ENV=staging
# Generate ONCE (php artisan key:generate --show), store in the secret store,
# paste here. NEVER regenerate on deploy: it encrypts sessions, queued jobs,
# WhatsApp phone numbers and their hashes.
APP_KEY=
# Key rotation only: comma-separated previous keys. Never commit real keys.
# APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=https://api-staging.conejocreative.com
# Empty with the runbook topology: nginx talks FastCGI to PHP-FPM on the same
# server, so REMOTE_ADDR is already the client and HTTPS comes from FastCGI.
# Set the CDN/load-balancer IPs/CIDRs ONLY if one is placed in front of nginx
# (e.g. Cloudflare proxied DNS) — never '*'.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Supabase PostgreSQL (staging project, NOT the production one).
# Session pooler (port 5432) keeps prepared statements and advisory locks
# working; do not use the transaction pooler (6543) with this app.
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
# Runtime role (docs/pr-sec1a-2-db-runtime-privilege-plan.md); pooler format user.PROJECT_REF
DB_USERNAME=CHANGE_ME_RUNTIME_ROLE.CHANGE_ME_PROJECT_REF
DB_PASSWORD=CHANGE_ME
DB_SSLMODE=require

# Drivers: database, as in docs/staging-production-contract.md (one app
# server, no Redis to operate). Switch to Redis only together with a
# second app instance.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Environment-specific cookie name: never collides with local/production.
SESSION_COOKIE=aforo_staging_session
# REQUIRED when WEB_HOST != API_HOST: the SPA reads XSRF-TOKEN from
# document.cookie, so the cookie must be scoped to PARENT (leading dot).
SESSION_DOMAIN=.CHANGE_ME_PARENT_DOMAIN
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# SPA host(s), no scheme. Must include every CORS origin host.
SANCTUM_STATEFUL_DOMAINS=CHANGE_ME_WEB_HOST
# Exact origins with scheme; never a wildcard (credentials are on).
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_WEB_HOST
L5_SWAGGER_ENABLED=false

FILESYSTEM_DISK=local
PRODUCT_MEDIA_DISK=public

# Queues: one connection, one dedicated queue per concern, one supervised
# worker per queue (deploy/staging/supervisor-aforo-staging.conf).
QUEUE_CONNECTION=database
# Must stay above the WhatsApp job timeout (30) and its stale-claim window (60).
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
BROADCAST_QUEUE=realtime
AFORO_MAIL_QUEUE=mail
WHATSAPP_QUEUE=whatsapp

CACHE_STORE=database
CACHE_PREFIX=aforo_staging_

BROADCAST_CONNECTION=reverb
# New values for staging (never the local ones). Generate:
#   app id: any short string; key: openssl rand -hex 16; secret: openssl rand -hex 32
REVERB_APP_ID=CHANGE_ME
# Public (also VITE_REVERB_APP_KEY in the SPA build).
REVERB_APP_KEY=CHANGE_ME
# Secret: server only.
REVERB_APP_SECRET=CHANGE_ME
# Public wss endpoint = API_HOST through nginx (/app and /apps -> 127.0.0.1:8081).
REVERB_HOST=api-staging.conejocreative.com
REVERB_PORT=443
REVERB_SCHEME=https
# Reverb itself listens on loopback only; nginx terminates TLS.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
# Bare SPA hostname(s) only — no scheme, no port, never '*'.
REVERB_ALLOWED_ORIGINS=CHANGE_ME_WEB_HOST

# --- E-mail -------------------------------------------------------------
# Mode A (default until an SMTP provider is chosen): PROTECTED CAPTURE.
# Messages go ONLY to storage/logs/mail-capture.log (0600, outside public/).
# Nothing is delivered to any inbox; read invitation links over SSH.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail_capture
# Mode B: real SMTP (provider credentials from its dashboard). Domain must
# have the provider's SPF/DKIM (and DMARC) records before switching.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=CHANGE_ME_SMTP_HOST
# MAIL_PORT=587
# MAIL_USERNAME=CHANGE_ME
# MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="CHANGE_ME@CHANGE_ME_MAIL_DOMAIN"
MAIL_FROM_NAME="AFORO (staging)"

# Base URL of the SPA: invitation, password reset and Cierre links.
AFORO_WEB_URL=https://CHANGE_ME_WEB_HOST
AFORO_DAY_CLOSE_REPORT_PATH=/app/day-close/{id}

# --- WhatsApp Cloud API: Cierre Diario delivery -------------------------
# Keep false until the Meta setup in docs/whatsapp-meta-audit.md §6 is
# done with a TEST number. NEVER commit real values.
WHATSAPP_CLOUD_ENABLED=false
# Explicit Graph API version, never "latest" (v25.0 valid until 2028-07-29).
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_PHONE_NUMBER_ID=
# System user token (whatsapp_business_messaging + whatsapp_business_management). Secret.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_ES
# Random string you choose; also typed in the App Dashboard. Secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App secret — validates X-Hub-Signature-256. Secret.
META_APP_SECRET=
