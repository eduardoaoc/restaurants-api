APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Key rotation only: comma-separated previous keys. Never commit real keys.
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
# Staging/production: APP_ENV=staging/production, APP_DEBUG=false and HTTPS APP_URL.
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Staging/production: LOG_LEVEL=info; LOG_STACK=stderr or daily per hosting.
LOG_DAILY_DAYS=14

# Local Sail uses PostgreSQL; SQLite is optional outside Sail (DB_CONNECTION=sqlite).
# Staging/production also use PostgreSQL with environment-specific credentials.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=restaurants
DB_USERNAME=sail
DB_PASSWORD=
# Local only. Staging/production: require (or verify-full with trusted CA).
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Local HTTP only; staging/production HTTPS requires true.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# SPA hosts with ports, without schemes. Set explicitly for each environment.
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173,127.0.0.1:5173

# Exact origins including scheme/port; no wildcard with credentialed requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Unset defaults to enabled only in local/testing. Keep false in staging/production.
# L5_SWAGGER_ENABLED=false

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
# Disk product photos/videos are stored on — see config/media.php. Kept
# independent of FILESYSTEM_DISK so it can move to S3/a CDN later without
# an application code change.
PRODUCT_MEDIA_DISK=public
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=90
QUEUE_FAILED_DRIVER=database-uuids
# Worker --timeout must be lower than retry_after; restart workers after releases.

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
# Bare hostnames only (no scheme/port) — Reverb matches against
# parse_url($origin, PHP_URL_HOST). Never use '*'.
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- WhatsApp Cloud API: Cierre Diario delivery (CARTA 9.1E) ------------
# One central AFORO sender. NEVER commit real values. See
# docs/whatsapp-daily-close.md for how to obtain each one.
WHATSAPP_CLOUD_ENABLED=false
# Explicit Graph API version, e.g. v25.0 — never "latest".
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
# System user access token (whatsapp_business_messaging). Secret.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WABA_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_ES
# Webhook verify token of your choosing (also set in the Meta App Dashboard). Secret.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App secret — validates X-Hub-Signature-256 on webhooks. Secret.
META_APP_SECRET=
# Base URL of the AFORO web app (report links in the message).
AFORO_WEB_URL=
AFORO_DAY_CLOSE_REPORT_PATH=/app/day-close/{id}
